<?xml version="1.0" encoding="utf-8"?>
<!-- Service tile of a widget item: monogram on the subscription colour (setColorFilter), and over it the
     bundled / custom logo on its light plate when there is one (bitmap from code). Sized by the parent. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants">

    <ImageView
        android:id="@+id/row_tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_tile" />

    <TextView
        android:id="@+id/row_mono"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/row_logo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone" />
</FrameLayout>
