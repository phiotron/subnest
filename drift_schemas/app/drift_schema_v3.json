  "fixed_sql": [
    {
      "name": "subscriptions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subscriptions\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"service_id\" TEXT NULL, \"color_value\" INTEGER NOT NULL, \"icon_text\" TEXT NULL, \"custom_logo_file\" TEXT NULL, \"category_id\" TEXT NOT NULL DEFAULT 'other', \"price_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL, \"cycle_every\" INTEGER NOT NULL, \"cycle_unit\" TEXT NOT NULL, \"anchor_date\" TEXT NOT NULL, \"period_index\" INTEGER NOT NULL DEFAULT 0, \"status\" TEXT NOT NULL, \"trial_end_date\" TEXT NULL, \"shared_with\" INTEGER NOT NULL DEFAULT 1, \"reminder_offsets\" TEXT NULL, \"payment_method_id\" TEXT NULL, \"manage_url\" TEXT NULL, \"notes\" TEXT NULL, \"start_date\" TEXT NOT NULL, \"cancelled_on\" TEXT NULL, \"paused_from\" TEXT NULL, \"worth_it\" TEXT NULL, \"detection_source\" TEXT NULL, \"detected_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "confirmed_periods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"confirmed_periods\" (\"id\" TEXT NOT NULL, \"subscription_id\" TEXT NOT NULL REFERENCES subscriptions (id) ON DELETE CASCADE, \"due_date\" TEXT NOT NULL, \"outcome\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL, \"confirmed_at\" INTEGER NOT NULL, \"source\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"subscription_id\", \"due_date\"));"
        }
      ]
    },
    {
      "name": "cached_rates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_rates\" (\"code\" TEXT NOT NULL, \"per_usd\" REAL NOT NULL, PRIMARY KEY (\"code\"));"
        }
      ]
    },
    {
      "name": "rate_overrides",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rate_overrides\" (\"pair\" TEXT NOT NULL, \"rate\" REAL NOT NULL, PRIMARY KEY (\"pair\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NULL, \"color_value\" INTEGER NOT NULL, \"icon\" TEXT NULL, \"sort_order\" INTEGER NOT NULL, \"built_in_key\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "labels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"labels\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color_value\" INTEGER NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "subscription_labels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subscription_labels\" (\"subscription_id\" TEXT NOT NULL REFERENCES subscriptions (id) ON DELETE CASCADE, \"label_id\" TEXT NOT NULL REFERENCES labels (id) ON DELETE CASCADE, PRIMARY KEY (\"subscription_id\", \"label_id\"));"
        }
      ]
    },
    {
