          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"id\" TEXT NOT NULL, \"category_id\" TEXT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
